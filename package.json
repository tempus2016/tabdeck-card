{
  "name": "tabdeck-card",
  "version": "1.2.1",
  "description": "A modern tabbed card for Home Assistant Lovelace dashboards.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:demo": "vite build --config vite.demo.config.ts",
    "demo": "vite --config vite.demo.config.ts",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "build:site": "npm run docs:build && npm run build:demo",
    "test:visual": "node scripts/visual/visual.mjs",
    "test:ha": "node scripts/compat/ha-compat.mjs"
  },
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitepress": "2.0.0-alpha.21",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
