{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tabdeck style preset",
  "description": "A shareable Tabdeck look. Only style options are allowed; tabs and behaviour are never part of a preset.",
  "type": "object",
  "required": [
    "name",
    "author",
    "config"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 40,
      "description": "Shown in the gallery"
    },
    "author": {
      "type": "string",
      "maxLength": 40,
      "description": "GitHub user name of whoever made it"
    },
    "description": {
      "type": "string",
      "maxLength": 200,
      "description": "One sentence about the look"
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "preset": {
          "enum": [
            "default",
            "ios",
            "material",
            "glass",
            "minimal",
            "rail",
            "neumorphic",
            "ha-tile",
            "mushroom",
            "bubble",
            "fluent",
            "material-you",
            "material-expressive",
            "liquid-glass",
            "accessible"
          ],
          "description": "A named style bundle"
        },
        "position": {
          "enum": [
            "top",
            "bottom",
            "left",
            "right"
          ],
          "description": "Where the tab bar sits"
        },
        "style": {
          "enum": [
            "underline",
            "pill",
            "segmented",
            "boxed",
            "text",
            "rail"
          ],
          "description": "Tab bar style"
        },
        "tab_display": {
          "enum": [
            "both",
            "icon",
            "label",
            "active",
            "dots"
          ],
          "description": "What each tab shows"
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "justify"
          ],
          "description": "Tab alignment"
        },
        "badge_display": {
          "enum": [
            "text",
            "dot"
          ],
          "description": "Badges as text or a dot"
        },
        "density": {
          "enum": [
            "compact",
            "default",
            "comfortable"
          ],
          "description": "Tab bar size"
        },
        "transition": {
          "enum": [
            "none",
            "fade",
            "slide",
            "scale",
            "flip",
            "rise"
          ],
          "description": "Panel transition"
        },
        "transition_duration": {
          "type": "number",
          "description": "Transition length (ms)",
          "minimum": 0,
          "maximum": 2000
        },
        "transition_easing": {
          "type": "string",
          "description": "Transition easing (CSS)"
        },
        "indicator_size": {
          "type": "number",
          "description": "Underline thickness (px)",
          "minimum": 1,
          "maximum": 16
        },
        "indicator_radius": {
          "type": "number",
          "description": "Indicator corner radius (px)",
          "minimum": 0,
          "maximum": 100
        },
        "animated": {
          "type": "boolean",
          "description": "Animate the indicator"
        },
        "liquid_indicator": {
          "type": "boolean",
          "description": "The moving indicator stretches to the new tab like a drop, then settles"
        },
        "accent_indicator": {
          "type": "boolean",
          "description": "Indicator takes the tab's accent"
        },
        "elevation": {
          "type": "boolean",
          "description": "A shadow under the bar"
        },
        "bar_background": {
          "type": "string",
          "description": "Bar background colour"
        },
        "glass": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number",
              "minimum": 1,
              "maximum": 60
            }
          ],
          "description": "Frosted-glass bar and menus: true, or the blur in px (default 14)"
        },
        "styles": {
          "type": "object",
          "description": "CSS variables only (--tabdeck-…). Values can't contain url(), ; { } < > or \\.",
          "propertyNames": {
            "pattern": "^--tabdeck-[a-z0-9-]+$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      }
    }
  }
}
