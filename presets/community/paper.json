{
  "$schema": "../preset.schema.json",
  "name": "Paper",
  "author": "tempus2016",
  "description": "Warm cream bar with a brown underline and a serif font.",
  "config": {
    "style": "underline",
    "indicator_size": 2,
    "bar_background": "#f6f1e7",
    "styles": {
